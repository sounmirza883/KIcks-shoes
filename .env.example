# Supabase (database + auth). Copy this file to .env.local and fill in the values.
# Find them in Supabase Dashboard > Project Settings > API (project URL, and the anon / publishable key).
# Both are PUBLIC by design: Next.js inlines NEXT_PUBLIC_ variables into the browser bundle, and the data is
# protected by the row-level security in supabase/schema.sql. NEVER put the service_role key in a NEXT_PUBLIC_ variable.
# On Vercel set the same two names under Project Settings > Environment Variables and redeploy
# (Next.js reads them at build time).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-OR-PUBLISHABLE-KEY"
